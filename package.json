{
  "name": "youtube-subscriber-spreadsheet-apps-script",
  "version": "1.1.3",
  "author": "Chris K.Y. FUNG (https://chriskyfung.github.io/)",
  "description": "Google Apps Script to extract and record the information of your YouTube subscribers from Gmail to Google Sheet",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/chriskyfung/youtube-subscriber-spreadsheet-apps-script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chriskyfung/youtube-subscriber-spreadsheet-apps-script.git"
  },
  "bugs": {
    "url": "https://github.com/chriskyfung/youtube-subscriber-spreadsheet-apps-script/issues"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">= 20.0.0"
  },
  "scripts": {
    "build": "rollup --config",
    "build:clean": "rimraf build/",
    "build:watch": "npm run build -- --watch",
    "clasp:create": "rimraf .clasp.json && clasp create && prettier --write .clasp.json",
    "clasp:login": "clasp login",
    "deploy": "npm run check:all && npm run build && npm run push",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "push": "clasp push",
    "push:watch": "npm run push -- --watch",
    "test": "jest",
    "test:file": "jest --bail --findRelatedTests --passWithNoTests",
    "test:watch": "npm run test -- --watchAll",
    "check:all": "npm run lint:check && npm run format:check && npm run types:check && npm test",
    "types:check": "tsc"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-typescript": "^8.0.1",
    "@google/clasp": "^3.4.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/google-apps-script": "^2.0.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.12",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "js-yaml": "^4.2.0",
    "uuid": "^11.1.1"
  },
  "keywords": [
    "clasp",
    "google-apps-script",
    "gmail",
    "google-sheet",
    "youtubers-toolkit",
    "youtube-subscribers"
  ],
  "lint-staged": {
    "**/*.{js,ts}": [
      "eslint --fix",
      "prettier --write",
      "npm run test:file"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
